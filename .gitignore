# Local build outputs
bin/
*.test

# Runtime/local state
data/
.issueops-runtime/
.codegraph/
cache/
.omx/
.omc/
.fablize/
.codex/
.claude/
.cache/
.antigravitycli/
.omo/
.omp/
.agents/
# Local workflow evidence (root, .issueops, and the verified-execution roots
# under skills/verified-execution). A bare name would also hide any source
# directory or file called "evidence".
/evidence/
.issueops/evidence/
.issueops/verified-execution/evidence/
/.verified-execution/evidence/
.issueops/state/

# Language/tool caches
__pycache__/
*.pyc
.DS_Store

# Prompt examples
GOOD_PROMPT_EXAMPLE.md

# Local, non-portable skill background
skills/*/background.local.md
# Per-issue artifact folder: review working files and tmp are never committed (#480)
.issueops/issues/*/review/
.issueops/tmp/
.issueops/issues/*/artifact/
