{
  "schema_version": 1,
  "max_root_lines": 250,
  "max_module_lines": 250,
  "families": [
    {
      "root": ".issueops/ADR.md",
      "module_dir": ".issueops/adr",
      "responsibility": "accepted architecture decisions and roadmap"
    },
    {
      "root": ".issueops/ARCHITECTURE.md",
      "module_dir": ".issueops/architecture",
      "responsibility": "dependency direction and runtime topology"
    },
    {
      "root": ".issueops/CAUTIONS.md",
      "module_dir": ".issueops/cautions",
      "responsibility": "known risks and incident lessons"
    },
    {
      "root": ".issueops/CONVENTIONS.md",
      "module_dir": ".issueops/conventions",
      "responsibility": "implementation and interface conventions"
    },
    {
      "root": ".issueops/OPERATIONS.md",
      "module_dir": ".issueops/operations/guides",
      "responsibility": "installation and runtime operation"
    },
    {
      "root": ".issueops/TESTING.md",
      "module_dir": ".issueops/testing",
      "responsibility": "test strategy and verification gates"
    }
  ],
  "single_owner_topics": {
    "commit formatting": ".issueops/COMMIT_POLICY.md",
    "constitutional priority and safety": ".issueops/CONSTITUTION.md",
    "OpenAPI requirements": ".issueops/OPEN_API_SPEC.md",
    "technology selection": ".issueops/TECH_STACK.md",
    "agent execution sequence": ".issueops/AGENT_WORKFLOW.md",
    "issueops historical audit": ".issueops/archive/issueops-audit.md",
    "whole-project audit snapshot": ".issueops/PROJECT_AUDIT.md",
    "capability domain responsibilities": ".issueops/architecture/domain-responsibilities.md",
    "issueops execution cleanup boundary": ".issueops/architecture/issueops-cleanup.md",
    "skill discovery and source inventory": ".issueops/TECH_STACK.md",
    "documentation structure and quality": ".issueops/documentation/README.md",
    "pioneer evaluator policy": ".issueops/research/skill-quality/pioneer-skill-quality-rubric.md"
  },
  "root_documents": [
    ".issueops/SUB_AGENT_PATTERNS.md"
  ],
  "directories": {
    ".issueops/plans": "plans without an issue number, written by implementation-planning (including the former issues/_unnumbered plans); ADRs cite them as decision sources",
    ".issueops/research": "research and evaluation results written by web-research and quality reviews, including the skill-quality evaluator rubric, scorecards, and dated dogfood reports",
    ".issueops/prompt-engineering": "versioned prompts owned by the prompt-engineering skill; owner-prompt parity tests read prompts/ by exact path",
    ".issueops/archive": "historical snapshots that no longer describe the current system but are still cited"
  },
  "fixed_documents": [
    ".issueops/operations/install.md",
    ".issueops/operations/verification.md",
    ".issueops/operations/release-reproducibility.md",
    ".issueops/operations/release-dogfood-notes.md",
    ".issueops/operations/quality-dashboard.md"
  ]
}
