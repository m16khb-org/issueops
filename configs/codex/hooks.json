{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'./bin/issueops' hook session-start --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "'./bin/issueops' hook subagent-start --host codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
